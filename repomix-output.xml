@import "tailwindcss";

:root{--ivory:#FAF9F6;--navy:#0B192C;--navy-deep:#122136;--gold:rgb(191, 130, 16);--gold-bright:#E6C98B}
html{scroll-behavior:smooth;scroll-padding-top:82px;overflow-x:hidden}body{min-width:320px}
body{margin:0;background:var(--ivory);color:var(--navy);font-family:var(--font-poppins),Poppins,Arial,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
*,button,input,textarea,select{font-family:inherit}
img{display:block;max-width:100%;height:auto}
a{transition:color .25s ease,background-color .25s ease,border-color .25s ease,opacity .25s ease,transform .25s ease}
a:not(.gold-button):hover{color:var(--gold)}
.container{width:min(1180px,calc(100% - 32px));margin:auto}
.section{padding:60px 0}
.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:.72rem;font-weight:800;color:var(--gold)}
.heading{font-size:clamp(1.875rem,3.2vw,2.75rem);line-height:1.12;font-weight:800;letter-spacing:-.03em}
.copy{color:#405066;line-height:1.8;font-size:1.05rem}
.card{border:1px solid #e6dfd2;background:white;border-radius:24px;box-shadow:0 16px 50px #0b192c0d}
.gold-button{background:linear-gradient(90deg,#E6C98B,#DAB672,#F0D9A6);color:#122136;box-shadow:0 8px 24px #1221361f;transition:filter .3s,transform .3s}
.gold-button:hover{filter:brightness(1.06);transform:translateY(-1px);color:#122136!important}
.pulse-ring{position:absolute;inset:-7px;border-radius:9999px;border:2px solid rgba(218,182,114,.72);box-shadow:0 0 16px rgba(218,182,114,.34);opacity:.7;animation:pulse-ring 2s cubic-bezier(.2,.7,.3,1) infinite;pointer-events:none}
.pulse-ring.delay{animation-delay:1s}
@keyframes pulse-ring{0%{transform:scale(.88);opacity:.8;box-shadow:0 0 12px rgba(218,182,114,.45)}70%,100%{transform:scale(1.58);opacity:0;box-shadow:0 0 30px rgba(218,182,114,0)}}
.hero-title{font-size:clamp(1.875rem,4vw,3.5rem);line-height:1.08;font-weight:700;letter-spacing:-.035em;text-shadow:0 2px 18px rgba(0,0,0,.5)}
.hero-copy{color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.65)}
.hero-overlay{background:linear-gradient(90deg,rgba(11,25,44,.44),rgba(11,25,44,.30),rgba(11,25,44,.16))}
.service-carousel{position:relative;overflow:hidden;background:transparent}
.scroll-reveal{opacity:0;transform:translate3d(0,18px,0);will-change:transform,opacity;transition:opacity .65s ease,transform .65s cubic-bezier(.2,.7,.2,1);transition-delay:var(--reveal-delay,0ms)}
.scroll-reveal.is-visible{opacity:1;transform:translate3d(0,0,0)}
.hover-image{overflow:hidden}
.hover-image img{transition:transform .5s ease,filter .5s ease;will-change:transform}
.hover-image:hover img{transform:scale(1.05);filter:brightness(1.04)}
.service-track{display:flex;gap:16px;width:100%;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;-ms-overflow-style:none;padding:4px 0 12px;will-change:scroll-position}
.service-track::-webkit-scrollbar{display:none}
.service-slide{width:100%;flex:0 0 100%;scroll-snap-align:start}
.service-carousel-controls{display:flex;justify-content:flex-end;gap:10px;margin-bottom:16px}
.service-arrow{display:grid;place-items:center;width:44px;height:44px;border:1px solid #DAB672;border-radius:9999px;background:white;color:#122136;box-shadow:0 8px 20px #0b192c12;transition:background-color .25s,color .25s,transform .25s}
.service-arrow:hover{background:#DAB672;color:#122136;transform:translateY(-1px)}
@media(min-width:1024px){
  .service-carousel-controls{position:absolute;inset-inline:0;top:50%;z-index:20;display:flex;justify-content:space-between;align-items:center;margin:0;transform:translateY(-50%);pointer-events:none}
  .service-arrow{pointer-events:auto}
}
@media(max-width:1023px){html{scroll-padding-top:70px}.section{scroll-margin-top:70px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.service-track{scroll-behavior:auto}img{transition:none}a{transition:none}.scroll-reveal{opacity:1;transform:none;transition:none;will-change:auto}}
@media(max-width:640px){.container{width:min(100% - 24px,1180px)}.section{padding:48px 0}.copy{font-size:1rem}.hero-title{font-size:clamp(1.9rem,9vw,2.8rem)}.service-carousel-controls{margin-bottom:12px}.service-arrow{width:40px;height:40px}}
@media(min-width:641px) and (max-width:1023px){.section{padding:56px 0}.container{width:min(100% - 32px,1180px)}.hero-title{font-size:clamp(2.2rem,5vw,3.25rem)}}
